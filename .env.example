# ─────────────────────────────────────────────────────────────
# Headless WordPress source
# ─────────────────────────────────────────────────────────────
# Origin of the WordPress instance the Make.com pipeline publishes into.
# Only the origin — no path, no trailing slash. The REST route is appended.
#
# Leave this unset to build from the JSON files already in content/articles/.
#
#   WORDPRESS_URL=https://cms.theukmag.com
#
# Then:  npm run sync:wp && npm run build
WORDPRESS_URL=

# Reading is unauthenticated: the sync only requests published posts, which the
# WordPress REST API serves publicly. No application password is needed here,
# and none should be committed. Credentials belong in Make.com, which is the
# only side that writes.

# ─────────────────────────────────────────────────────────────
# Web push (OneSignal) — OPTIONAL
# ─────────────────────────────────────────────────────────────
# PUBLIC client identifier. Safe to expose: it identifies the app to the
# browser and is visible in any web client by design. Leave it empty and the
# notification UI never appears — the rest of the PWA (install, offline
# caching, update prompt) works exactly the same without it.
#
# Get it from: OneSignal dashboard → Settings → Keys & IDs → App ID
#
#   NEXT_PUBLIC_ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# ⚠️ The OneSignal REST API Key is a SECRET and must NEVER be put in this file,
# in any NEXT_PUBLIC_* variable, in public/, or anywhere else in this
# repository. It can send a notification to every subscriber. It belongs only
# in the OneSignal dashboard, or in the secret store of whatever server sends
# notifications later. The static site never needs it: it only subscribes
# readers, it never sends.
